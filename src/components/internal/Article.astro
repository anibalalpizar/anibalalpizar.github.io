---
// Template shared by case studies and blog posts: hero, data strip, the MDX
// body (passed as the default slot), Previous / Next and the footer.
import Marks from "../Marks.astro"
import PageBar from "./PageBar.astro"
import PageFooter from "./PageFooter.astro"
import { ui, type Lang } from "../../i18n/ui"

export interface Cell {
  label: string
  value: string
  sub?: string
  /** ISO date: `sub` is then "2y ago", refreshed in the browser. */
  date?: string
}

export interface Neighbor {
  name: string
  href: string
}

interface Props {
  lang: Lang
  backHref: string
  backLabel: string
  meta: string
  metaPrefix?: string
  lead: string
  cells: Cell[]
  /** Accessible name of the Previous / Next nav, e.g. "Case study". */
  pagerLabel: string
  prev?: Neighbor
  next?: Neighbor
}

const { lang, backHref, backLabel, meta, metaPrefix, lead, cells, pagerLabel, prev, next } =
  Astro.props
const t = ui[lang]
---

<main class="page article">
  <section id="top" class="hero">
    <PageBar backHref={backHref} backLabel={backLabel} metaPrefix={metaPrefix} meta={meta} />
    <h1><slot name="title" /></h1>
    <p class="lead">{lead}</p>
  </section>

  <section class="facts">
    <Marks />
    <div class="cells">
      {
        cells.map((cell) => (
          <div class="cell">
            <span class="cell-label">{cell.label}</span>
            <span class="cell-value">
              <span>{cell.value}</span>
              {cell.sub && (
                <span class="cell-sub" data-ago={cell.date} data-lang={lang}>
                  {cell.sub}
                </span>
              )}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <slot />

  {
    (prev || next) && (
      <nav class="pager" aria-label={pagerLabel}>
        <Marks />
        {prev && (
          <a href={prev.href} class="pager-link">
            <span class="pager-label">{t.prev}</span>
            <span class="pager-name">{prev.name}</span>
          </a>
        )}
        {next && (
          <a href={next.href} class="pager-link next">
            <span class="pager-label">{t.next}</span>
            <span class="pager-name">{next.name}</span>
          </a>
        )}
      </nav>
    )
  }

  <PageFooter lang={lang} />
</main>

<script>
  import type { Lang } from "../../i18n/ui"
  import { timeAgo } from "../../utils/dates"

  // "2y ago" is computed at build time; refresh it so it doesn't go stale.
  document.querySelectorAll<HTMLElement>("[data-ago]").forEach((el) => {
    if (el.dataset.ago) el.textContent = timeAgo(el.dataset.ago, el.dataset.lang as Lang)
  })
</script>

<style>
  /* Section and Fig. numbers are CSS counters, incremented by the MDX components. */
  .article {
    counter-reset: section figure;
  }

  .hero {
    position: relative;
    padding: clamp(84px, 11vw, 136px) var(--px) clamp(44px, 6vw, 72px);
  }

  h1 {
    max-width: 1000px;
    font-size: clamp(28px, 4.4vw, 52px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.04;
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  /* Never split the client's name ("techkep-percr"). */
  h1 :global(a) {
    hyphens: manual;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
    transition: opacity 150ms ease;
  }

  h1 :global(a:hover),
  h1 :global(a:focus-visible) {
    opacity: var(--dim);
  }

  .lead {
    margin-top: clamp(28px, 4vw, 44px);
    max-width: 640px;
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.55;
    opacity: var(--dim);
    text-wrap: pretty;
    hyphens: auto;
  }

  .facts,
  .pager {
    position: relative;
    border-top: 1px solid var(--line);
  }

  .cells {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
  }

  /* flex-basis auto lets a long cell (Stack) drop to its own full-width row. */
  .cell {
    flex: 1 1 auto;
    min-width: min(100%, 200px);
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px var(--px);
    background: var(--bg);
  }

  .cell-label {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: var(--dim);
  }

  .cell-value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
  }

  .cell-sub {
    font-size: 12px;
    opacity: var(--dim);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
  }

  .pager-link {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(28px, 4vw, 40px) var(--px);
    background: var(--bg);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .pager-link:focus-visible {
    background: var(--fg);
    color: var(--bg);
  }

  /* Hover only with a mouse: on touch screens it stays stuck after a tap. */
  @media (hover: hover) {
    .pager-link:hover {
      background: var(--fg);
      color: var(--bg);
    }
  }

  .next {
    align-items: flex-end;
    text-align: right;
  }

  .pager-label {
    font-size: 12px;
    opacity: var(--dim);
  }

  .pager-name {
    font-size: clamp(20px, 2.6vw, 30px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  /* Full-width: the ring goes inside, where the frame can't cover it. */
  .pager-link:focus-visible {
    outline-offset: -4px;
  }

  @media (hover: none) {
    .pager-link:active {
      background: var(--hover);
    }
  }

  @media (max-width: 639.98px) {
    /* In ~36-character lines automatic hyphens split almost every line. */
    h1,
    .lead {
      hyphens: manual;
    }

    /* Data strip → key/value list. */
    .cell {
      flex: 1 1 100%;
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
      padding: 14px var(--px);
    }

    .cell-label {
      flex: 0 0 96px;
    }
  }
</style>
