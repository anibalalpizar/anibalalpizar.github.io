---
// Top bar of an internal page hero: a way back on the left, a counter on the right.
interface Props {
  backHref: string
  backLabel: string
  meta: string
  /** Shown before `meta` except below 360px, e.g. "Case study" in "Case study 01 / 04". */
  metaPrefix?: string
}

const { backHref, backLabel, meta, metaPrefix } = Astro.props
---

<div class="bar">
  <a href={backHref} class="back">{backLabel}</a>
  <span class="meta">{metaPrefix && <span class="prefix">{metaPrefix} </span>}{meta}</span>
</div>

<style>
  .bar {
    position: absolute;
    top: 20px;
    left: var(--px);
    right: var(--px);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .back,
  .meta {
    opacity: var(--dim);
  }

  .back {
    transition: opacity 150ms ease;
  }

  .back:hover,
  .back:focus-visible {
    opacity: 1;
  }

  .meta {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 359.98px) {
    .prefix {
      display: none;
    }
  }
</style>
