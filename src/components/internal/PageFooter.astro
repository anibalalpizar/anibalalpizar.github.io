---
import Marks from "../Marks.astro"
import { localePath, ui, type Lang } from "../../i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const year = new Date().getFullYear()
const blogHref = localePath(lang, "/blog")
// Below 760px the nav links are hidden, so the footer is a visible way to the blog.
// Not on the blog list itself.
const showBlog = Astro.url.pathname !== blogHref
---

<footer class="footer">
  <Marks />
  <span class="dim">© {year} Aníbal</span>
  <span class="links">
    {showBlog && <a href={blogHref} class="dim link">{ui[lang].navBlog}</a>}
    <a href="#top" class="dim link" data-scroll-to="top">{ui[lang].backTop}</a>
  </span>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 20px var(--px);
    border-top: 1px solid var(--line);
    font-size: 12px;
  }

  .links {
    display: flex;
    gap: 20px;
  }

  .dim {
    opacity: var(--dim);
  }

  .link {
    transition: opacity 150ms ease;
  }

  .link:hover,
  .link:focus-visible {
    opacity: 1;
  }
</style>
