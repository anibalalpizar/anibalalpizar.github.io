---
import Marks from "./Marks.astro"
import { sections } from "../data/site"
import { localePath, ui, type Lang } from "../i18n/ui"
import type { Page } from "../data/site"

interface Props {
  lang: Lang
  page: Page
  path: string
}

const { lang, page, path } = Astro.props
const t = ui[lang]
const home = localePath(lang, "/")

// Which nav link is "current" on internal pages.
const currentSection = page === "case" ? "experience" : page === "projects" ? "projects" : null
const blogCurrent = page === "blog" || page === "post"
---

<header class="header">
  <Marks edge="bottom" />
  {
    page === "home" ? (
      <a href={`${home}#top`} class="logo" data-scroll-to="top">
        Aníbal
      </a>
    ) : (
      <a href={home} class="logo">
        Aníbal
      </a>
    )
  }
  <nav class="nav" aria-label={t.ariaMain}>
    <div class="links">
      {
        sections.map(({ id, key }) => {
          const current = id === currentSection
          // On /projects, "Projects" goes back to the top of that page.
          const scrollTarget = page === "projects" && id === "projects" ? "top" : id
          return (
            <a
              href={`${home}#${id}`}
              class:list={["link", { current }]}
              aria-current={current ? "page" : undefined}
              data-scroll-to={scrollTarget}
            >
              {t[key]}
            </a>
          )
        })
      }
      <a
        href={localePath(lang, "/blog")}
        class:list={["link", { current: blogCurrent }]}
        aria-current={blogCurrent ? "page" : undefined}
      >
        {t.navBlog}
      </a>
      <span class="divider" aria-hidden="true"></span>
    </div>
    <div class="languages" role="group" aria-label={t.ariaLang}>
      {
        (["en", "es"] as const).map((option) => (
          <button
            type="button"
            lang={option}
            class="language"
            aria-pressed={option === lang ? "true" : "false"}
            data-language={option}
            data-href={localePath(option, path)}
          >
            {option.toUpperCase()}
          </button>
        ))
      }
    </div>
    <button type="button" class="cmdk" aria-label={t.ariaMenu} data-open-command-menu>
      <span class="cmdk-keys">⌘K</span><span class="cmdk-menu">{t.menu}</span>
    </button>
    <button type="button" class="theme" aria-label={t.ariaTheme} data-theme-toggle>
      <span class="theme-icon"></span>
    </button>
  </nav>
</header>

<script>
  import type { Lang } from "../i18n/ui"
  import { switchLanguage } from "../scripts/lang"
  import { toggleTheme } from "../scripts/theme"

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", toggleTheme)

  document.querySelectorAll<HTMLButtonElement>("[data-language]").forEach((button) => {
    button.addEventListener("click", () => {
      if (button.getAttribute("aria-pressed") === "true") return
      switchLanguage(button.dataset.language as Lang, button.dataset.href!)
    })
  })
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 clamp(16px, 3vw, 24px);
    border-bottom: 1px solid var(--line);
    background: var(--glass);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
  }

  .logo {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav,
  .links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .links {
    display: none;
  }

  @media (min-width: 760px) {
    .links {
      display: flex;
    }
  }

  .link {
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 14px;
    opacity: var(--dim);
    transition: opacity 150ms ease;
  }

  .link:hover,
  .link:focus-visible,
  .link.current {
    opacity: 1;
  }

  .divider {
    width: 1px;
    height: 16px;
    margin: 0 10px;
    background: var(--line);
  }

  .languages {
    height: 28px;
    display: flex;
    align-items: center;
    gap: 2px;
    margin-right: 6px;
    padding: 0 2px;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .language {
    height: 22px;
    padding: 0 6px;
    display: flex;
    align-items: center;
    border: 0;
    border-radius: 4px;
    background: transparent;
    font-size: 11px;
    letter-spacing: 0.04em;
    cursor: pointer;
    opacity: 0.5;
    transition:
      opacity 150ms ease,
      background-color 150ms ease;
  }

  .language:hover,
  .language:focus-visible {
    opacity: 1;
  }

  .language[aria-pressed="true"] {
    background: var(--active);
    opacity: 1;
    cursor: default;
  }

  .cmdk {
    height: 28px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    font-size: 12px;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 150ms ease;
  }

  .cmdk:hover,
  .cmdk:focus-visible {
    opacity: 1;
  }

  /* Below 760px the nav links are hidden and this button is the only way to
     navigate, so it says "Menu" instead of the shortcut. */
  .cmdk-menu {
    display: none;
  }

  @media (max-width: 759.98px) {
    .cmdk-keys {
      display: none;
    }

    .cmdk-menu {
      display: inline;
    }
  }

  .theme {
    width: 32px;
    height: 28px;
    margin-left: 2px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
  }

  .theme:hover,
  .theme:focus-visible {
    background: var(--hover);
  }

  .theme-icon {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }

  /* Phones: 36px controls, easier to tap. The ::after strip grows the touch
     area to 44px tall without changing how the buttons look. */
  @media (max-width: 639.98px) {
    .languages {
      height: 36px;
      margin-right: 8px;
    }

    .language {
      height: 30px;
      min-width: 32px;
      justify-content: center;
    }

    .cmdk {
      height: 36px;
      padding: 0 12px;
    }

    .theme {
      width: 36px;
      height: 36px;
      margin-left: 6px;
    }

    .language,
    .cmdk,
    .theme {
      position: relative;
    }

    .language::after,
    .cmdk::after,
    .theme::after {
      content: "";
      position: absolute;
      inset: -4px 0;
    }
  }
</style>
