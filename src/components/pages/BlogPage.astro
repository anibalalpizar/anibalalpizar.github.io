---
import Marks from "../Marks.astro"
import PageBar from "../internal/PageBar.astro"
import PageFooter from "../internal/PageFooter.astro"
import Layout from "../../layouts/Layout.astro"
import { FULL_NAME } from "../../data/site"
import { localePath, ui, type Lang } from "../../i18n/ui"
import { getPosts } from "../../utils/posts"
import { blogData } from "../../utils/structuredData"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const posts = await getPosts(lang)
const rssHref = lang === "es" ? "/es/rss.xml" : "/rss.xml"
---

<Layout lang={lang} title={`${t.navBlog} — ${FULL_NAME}`} path="/blog" page="blog"
  description={t.blogDescription}
  structuredData={blogData(
    lang,
    t.navBlog,
    t.blogDescription,
    posts.map((post) => ({ path: post.path, headline: post.data.title, date: post.data.date }))
  )}
>
  <main class="page">
    <section id="top" class="hero">
      <PageBar
        backHref={localePath(lang, "/")}
        backLabel={t.backHome}
        meta={`${posts.length} ${posts.length === 1 ? t.article : t.articles}`}
      />
      <div class="hero-row">
        <h1>{t.navBlog}</h1>
        <a href={rssHref} class="rss">{t.rss}</a>
      </div>
    </section>

    <section class="list">
      <Marks />
      {
        posts.map((post) => (
          <a href={localePath(lang, post.path)} class="row">
            <time class="date" datetime={post.data.date}>
              {post.data.date}
            </time>
            <div class="details">
              <span class="title">{post.data.title}</span>
              <span class="description">{post.data.description}</span>
              <span class="meta">
                <span>{post.data.tags.join(" · ")}</span>
                <span>
                  {post.minutes} {t.minRead}
                </span>
              </span>
            </div>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </section>

    <PageFooter lang={lang} />
  </main>
</Layout>

<style>
  .hero {
    position: relative;
    padding: clamp(84px, 11vw, 136px) var(--px) clamp(36px, 5vw, 56px);
  }

  .hero-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 28px;
    flex-wrap: wrap;
  }

  /* Same size as the /projects title. */
  h1 {
    margin-left: -0.04em;
    font-size: clamp(56px, 11vw, 136px);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .rss {
    font-size: 12px;
    opacity: var(--dim);
    transition: opacity 150ms ease;
  }

  .rss:hover,
  .rss:focus-visible {
    opacity: 1;
  }

  .list {
    position: relative;
    border-top: 1px solid var(--line);
  }

  /* Same grid as the Experience rows; the extra 28px on the right is the
     channel for the arrow. */
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(56px, 120px) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 22px calc(var(--px) + 28px) 22px var(--px);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .row + .row {
    border-top: 1px solid var(--line);
  }

  .row:focus-visible {
    background: var(--fg);
    color: var(--bg);
    outline-offset: -4px;
  }

  /* Hover only with a mouse: on touch screens it stays stuck after a tap. */
  @media (hover: hover) {
    .row:hover {
      background: var(--fg);
      color: var(--bg);
    }
  }

  @media (hover: none) {
    .row:active {
      background: var(--hover);
    }
  }

  .date {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .details {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .title {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .description {
    max-width: 66ch;
    line-height: 1.55;
    opacity: var(--dim);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 12px;
    opacity: var(--dim);
  }

  .arrow {
    position: absolute;
    top: 50%;
    right: var(--px);
    transform: translateY(-50%);
    font-size: 14px;
    line-height: 1;
  }

  @media (max-width: 359.98px) {
    h1 {
      font-size: 48px;
    }
  }

  /* Phones: the date goes above the title. */
  @media (max-width: 639.98px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 6px;
    }
  }
</style>
