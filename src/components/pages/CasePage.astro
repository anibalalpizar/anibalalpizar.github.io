---
import { render, type CollectionEntry } from "astro:content"
import Article from "../internal/Article.astro"
import { mdxComponents } from "../mdx"
import Layout from "../../layouts/Layout.astro"
import { experience, FULL_NAME } from "../../data/site"
import { L, localePath, ui, type Lang } from "../../i18n/ui"
import { formatDate, timeAgo } from "../../utils/dates"
import { caseData } from "../../utils/structuredData"
import { summary } from "../../utils/summary"

interface Props {
  lang: Lang
  entry: CollectionEntry<"cases">
}

const { lang, entry } = Astro.props
const { exp, path, date, titleHref, title, lead, facts, description = summary(lead) } = entry.data
const { Content } = await render(entry)
const t = ui[lang]
const two = (n: number) => String(n).padStart(2, "0")

// Case order follows the Experience rows that have a case study.
const studies = experience.filter((job) => job.casePath)
const index = studies.findIndex((job) => job.id === exp)
const job = studies[index]
if (!job) throw new Error(`${entry.id}: no Experience row with id "${exp}" and a casePath`)

const neighbor = (offset: number) => {
  const other = studies[index + offset]
  return other && { name: L(other.company, lang), href: localePath(lang, other.casePath!) }
}

const cells = [
  { label: t.date, value: formatDate(date, lang), sub: timeAgo(date, lang), date },
  { label: t.role, value: L(job.role, lang), sub: L(job.note, lang) },
  ...facts.map((fact) => ({ label: t[fact.key], value: fact.value })),
]

const headline = `${title.before}${title.link}${title.after}`
// Generated at build time by src/pages/og/[lang]/[year]/[slug].png.ts.
const ogImage = { path: `/og/${lang}${path}.png`, alt: headline }
---

<Layout lang={lang} title={`${headline} — ${FULL_NAME}`} path={path} page="case"
  description={description}
  ogImage={ogImage}
  article={{ publishedTime: date }}
  structuredData={caseData(lang, { path, headline, description, date, image: ogImage.path })}
>
  <Article
    lang={lang}
    backHref={localePath(lang, "/#experience")}
    backLabel={t.backToExperience}
    metaPrefix={t.caseStudy}
    meta={`${two(index + 1)} / ${two(studies.length)}`}
    lead={lead}
    cells={cells}
    pagerLabel={t.caseStudy}
    prev={neighbor(-1)}
    next={neighbor(1)}
  >
    <Fragment slot="title">
      {title.before}<a href={titleHref} target="_blank" rel="noreferrer">{title.link}</a>{title.after}
    </Fragment>
    <Content components={mdxComponents} />
  </Article>
</Layout>
