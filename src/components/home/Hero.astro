---
import { CV_URL } from "../../data/site"
import { localePath, ui, type Lang } from "../../i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const name = "Aníbal"
---

<section id="top" class="hero" data-hero>
  <div class="guide vertical" aria-hidden="true" data-guide-v></div>
  <div class="guide horizontal" aria-hidden="true" data-guide-h></div>
  <div class="hud" aria-hidden="true">
    <span>10.02° N, 84.21° W</span>
    <span class="readout" data-readout>{"X ----  Y ----"}</span>
  </div>
  <h1 class="name" aria-label={name}>
    {[...name].map((letter) => <span>{letter}</span>)}
  </h1>
  <div class="intro">
    <p class="bio">{t.bio}</p>
    <div class="actions">
      <a href={CV_URL} download class="button primary">
        {t.cv}<span class="arrow">↓</span>
      </a>
      <a href={localePath(lang, "/#contact")} class="button secondary" data-scroll-to="contact">
        {t.touch}
      </a>
    </div>
  </div>
</section>

<script>
  const IDLE = "X ----  Y ----"
  const pad = (n: number) => String(Math.max(0, n)).padStart(4, "0")

  const hero = document.querySelector<HTMLElement>("[data-hero]")
  const vertical = document.querySelector<HTMLElement>("[data-guide-v]")
  const horizontal = document.querySelector<HTMLElement>("[data-guide-h]")
  const readout = document.querySelector<HTMLElement>("[data-readout]")

  const finePointer = matchMedia("(hover: hover) and (pointer: fine)").matches
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches

  if (hero && vertical && horizontal && readout && finePointer && !reduceMotion) {
    hero.addEventListener("mousemove", (event) => {
      const rect = hero.getBoundingClientRect()
      const x = Math.round(event.clientX - rect.left)
      const y = Math.round(event.clientY - rect.top)
      vertical.style.transform = `translateX(${x}px)`
      vertical.style.opacity = "1"
      horizontal.style.transform = `translateY(${y}px)`
      horizontal.style.opacity = "1"
      readout.textContent = `X ${pad(x)}  Y ${pad(y)}`
    })

    hero.addEventListener("mouseleave", () => {
      vertical.style.opacity = "0"
      horizontal.style.opacity = "0"
      readout.textContent = IDLE
    })
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(96px, 14vw, 168px) var(--px) clamp(56px, 8vw, 104px);
  }

  .guide {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--guide);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .vertical {
    bottom: 0;
    width: 1px;
  }

  .horizontal {
    right: 0;
    height: 1px;
  }

  .hud {
    position: absolute;
    top: 20px;
    left: var(--px);
    right: var(--px);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 11px;
    letter-spacing: 0.04em;
    opacity: var(--dim);
    pointer-events: none;
  }

  .readout {
    white-space: pre;
    font-variant-numeric: tabular-nums;
  }

  .name {
    position: relative;
    z-index: 1;
    display: flex;
    margin: 0 0 0 -0.05em;
    font-size: clamp(72px, 15.5vw, 188px);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 0.84;
  }

  .name span {
    transition: font-weight 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Only with a mouse: on touch screens a tap would leave the letter thin. */
  @media (hover: hover) {
    .name span:hover {
      font-weight: 200;
    }
  }

  .intro {
    position: relative;
    z-index: 1;
    margin-top: clamp(36px, 5vw, 56px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }

  .bio {
    max-width: 460px;
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.55;
    opacity: var(--dim);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .button {
    height: 40px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
  }

  .primary {
    gap: 8px;
    background: var(--fg);
    color: var(--bg);
    transition: opacity 150ms ease;
  }

  .primary:hover,
  .primary:focus-visible {
    opacity: 0.84;
  }

  .arrow {
    font-size: 13px;
  }

  .secondary {
    border: 1px solid var(--line);
    background: var(--bg);
    transition: background-color 150ms ease;
  }

  .secondary:hover,
  .secondary:focus-visible {
    background: var(--hover);
  }

  /* The crosshair only follows a mouse, so its X/Y readout means nothing on touch. */
  @media (hover: none) {
    .readout {
      visibility: hidden;
    }
  }

  /* Phones: the buttons share the full width (each takes a row at 320px). */
  @media (max-width: 639.98px) {
    .actions {
      width: 100%;
    }

    .button {
      flex: 1 1 auto;
      justify-content: center;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name span {
      transition: none;
    }
  }
</style>
