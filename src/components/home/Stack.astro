---
import Marks from "../Marks.astro"
import SectionHeader from "./SectionHeader.astro"
import { stack } from "../../data/site"
import { L, ui, type Lang } from "../../i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<section id="stack" class="stack">
  <Marks />
  <SectionHeader index="03" title={ui[lang].navStack} />
  {
    stack.map((group) => (
      <div class="row">
        <span class="label">{L(group.label, lang)}</span>
        <div class="items">
          {group.items.map((item) => (
            <span class="item">{item}</span>
          ))}
        </div>
      </div>
    ))
  }
</section>

<style>
  .stack {
    position: relative;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(104px, 220px) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 22px var(--px);
    border-top: 1px solid var(--line);
  }

  .row:last-child {
    padding-bottom: 32px;
  }

  .label {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: var(--dim);
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 4px;
    margin: 0 -8px;
    font-size: clamp(16px, 1.7vw, 19px);
    letter-spacing: -0.015em;
  }

  .item {
    padding: 2px 8px;
    border-radius: 4px;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  .item:hover {
    background: var(--fg);
    color: var(--bg);
  }
</style>
