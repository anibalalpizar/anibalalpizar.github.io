---
import Marks from "../Marks.astro"

interface Props {
  title: string
}

const { title } = Astro.props

// Readable anchor from the title: "Frontend Development" → #frontend-development.
const id = title
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "")
---

<section id={id} class="section">
  <Marks />
  <div class="grid">
    <span class="index" aria-hidden="true"></span>
    <div class="body">
      <h2>{title}</h2>
      <slot />
    </div>
  </div>
</section>

<style>
  /* Sections are numbered 01, 02… in page order (counter reset in internal/Article). */
  .section {
    position: relative;
    border-top: 1px solid var(--line);
    counter-increment: section;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(56px, 120px) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: clamp(40px, 6vw, 64px) var(--px) clamp(36px, 5vw, 56px);
  }

  .index {
    font-size: 13px;
    opacity: var(--dim);
  }

  .index::before {
    content: counter(section, decimal-leading-zero);
  }

  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    max-width: 760px;
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.15;
    text-wrap: balance;
    hyphens: auto;
  }

  /* Paragraphs come from the MDX file, so they need :global to be styled here. */
  .body :global(p) {
    max-width: 66ch;
    line-height: 1.7;
    opacity: var(--dim);
    text-wrap: pretty;
    hyphens: auto;
  }

  .body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Inline code; inside a dimmed paragraph it dims too, on purpose. */
  .body :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--hover);
    font-family: inherit;
    font-size: 0.9em;
  }

  .body :global(h3) {
    margin-top: 12px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .body :global(ul),
  .body :global(ol) {
    max-width: 66ch;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    counter-reset: item;
  }

  .body :global(li) {
    display: flex;
    gap: 12px;
    line-height: 1.7;
    opacity: var(--dim);
    text-wrap: pretty;
  }

  /* Bullets are the 9px "+" of the frame marks. */
  .body :global(ul > li)::before {
    content: "";
    flex: 0 0 9px;
    height: 9px;
    margin-top: 8px;
    background:
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat,
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat;
  }

  /* Numbered: "01." in the same size as the section number. */
  .body :global(ol > li) {
    align-items: baseline;
    counter-increment: item;
  }

  .body :global(ol > li)::before {
    content: counter(item, decimal-leading-zero) ".";
    flex: 0 0 auto;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .body :global(blockquote) {
    max-width: 60ch;
    margin: 8px 0;
    padding: 2px 0 2px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-left: 1px solid currentColor;
  }

  .body :global(blockquote p) {
    font-size: 17px;
    line-height: 1.6;
    letter-spacing: -0.015em;
    opacity: 1;
  }

  /* Phones: the number goes above the title, and no automatic hyphens. */
  @media (max-width: 639.98px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 12px;
    }

    h2,
    .body :global(p),
    .body :global(li) {
      hyphens: manual;
    }
  }
</style>
