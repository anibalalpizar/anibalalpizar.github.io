---
import Marks from "../Marks.astro"

interface Props {
  title: string
}

const { title } = Astro.props

// Readable anchor from the title: "Frontend Development" → #frontend-development.
const id = title
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "")
---

<section id={id} class="section">
  <Marks />
  <div class="grid">
    <span class="index" aria-hidden="true"></span>
    <div class="body">
      <h2>{title}</h2>
      <slot />
    </div>
  </div>
</section>

<style>
  /* Sections are numbered 01, 02… in page order (counter reset in CasePage). */
  .section {
    position: relative;
    border-top: 1px solid var(--line);
    counter-increment: section;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(56px, 120px) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: clamp(40px, 6vw, 64px) var(--px) clamp(36px, 5vw, 56px);
  }

  .index {
    font-size: 13px;
    opacity: var(--dim);
  }

  .index::before {
    content: counter(section, decimal-leading-zero);
  }

  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    max-width: 760px;
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.15;
    text-wrap: balance;
    hyphens: auto;
  }

  /* Paragraphs come from the MDX file, so they need :global to be styled here. */
  .body :global(p) {
    max-width: 66ch;
    line-height: 1.7;
    opacity: var(--dim);
    text-wrap: pretty;
    hyphens: auto;
  }

  .body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
