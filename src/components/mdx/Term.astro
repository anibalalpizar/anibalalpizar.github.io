---
interface Props {
  name: string
}

const { name } = Astro.props
---

<div class="item">
  <dt>
    <span class="bullet" aria-hidden="true"></span>
    <span>{name}</span>
  </dt>
  <dd><slot /></dd>
</div>

<style>
  .item {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  dt {
    flex: 0 1 240px;
    min-width: 0;
    display: flex;
    gap: 12px;
    font-weight: 500;
    line-height: 1.5;
  }

  /* The system's "+" mark, as a bullet. */
  .bullet {
    flex: 0 0 9px;
    width: 9px;
    height: 9px;
    margin-top: 7px;
    opacity: var(--dim);
    background:
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat,
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat;
  }

  dd {
    flex: 1 1 320px;
    min-width: 0;
    margin: 0;
    line-height: 1.6;
    opacity: var(--dim);
    text-wrap: pretty;
  }

  /* Phones: description under the term, aligned with its text (9px cross + 12px gap). */
  @media (max-width: 639.98px) {
    dt {
      flex: 1 1 100%;
    }

    dd {
      flex: 1 1 100%;
      padding-left: 21px;
    }
  }
</style>
