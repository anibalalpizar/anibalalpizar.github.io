---
import { langFromPath, ui } from "../../i18n/ui"

interface Props {
  /** The id in a YouTube URL: youtube.com/watch?v=<id>. */
  youtubeId: string
  caption: string
}

const { youtubeId, caption } = Astro.props
const t = ui[langFromPath(Astro.url.pathname)]
const watchUrl = `https://www.youtube.com/watch?v=${youtubeId}`
---

<figure class="figure">
  <div class="plate">
    <div class="screen" data-video={youtubeId} data-title={caption}>
      <img
        src={`https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`}
        alt=""
        width="1280"
        height="720"
        loading="lazy"
        class="poster"
      />
      <button type="button" class="play">
        <span class="play-icon" aria-hidden="true">▶︎</span>{t.play}
      </button>
    </div>
  </div>
  <figcaption>
    <span class="label">
      <span class="number">{t.fig} <span class="count"></span></span>
      <span>{caption}</span>
    </span>
    <a href={watchUrl} target="_blank" rel="noreferrer" class="watch">{t.watch}</a>
  </figcaption>
</figure>

<script>
  // Facade: YouTube's iframe (and its scripts) only load after the click.
  document.querySelectorAll<HTMLElement>("[data-video]").forEach((screen) => {
    // The whole 16:9 box is the tap target, not just the button.
    screen.addEventListener("click", () => {
      if (screen.querySelector("iframe")) return
      const iframe = document.createElement("iframe")
      iframe.src = `https://www.youtube-nocookie.com/embed/${screen.dataset.video}?autoplay=1&rel=0`
      iframe.title = screen.dataset.title ?? ""
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      iframe.allowFullscreen = true
      screen.replaceChildren(iframe)
    })
  })
</script>

<style>
  /* Shares the figure counter with Figure.astro, so the video gets the next number. */
  .figure {
    margin: 0;
    border-top: 1px solid var(--line);
    counter-increment: figure;
  }

  .count::before {
    content: counter(figure, decimal-leading-zero);
  }

  .plate {
    padding: clamp(28px, 5vw, 64px) var(--px);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center center;
  }

  .screen {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    cursor: pointer;
    background:
      repeating-linear-gradient(135deg, transparent 0 11px, var(--line) 11px 12px),
      var(--bg);
  }

  .poster,
  .screen :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .poster {
    object-fit: cover;
  }

  .play {
    position: relative;
    height: 40px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 0;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 150ms ease;
  }

  .play:hover,
  .play:focus-visible {
    opacity: 0.84;
  }

  .play-icon {
    font-size: 11px;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    padding: 14px var(--px);
    border-top: 1px solid var(--line);
    font-size: 12px;
    line-height: 1.5;
  }

  .label {
    display: flex;
    gap: 12px;
    min-width: 0;
  }

  .number,
  .watch {
    opacity: var(--dim);
  }

  .number {
    flex-shrink: 0;
  }

  .watch {
    transition: opacity 150ms ease;
  }

  .watch:hover,
  .watch:focus-visible {
    opacity: 1;
  }

  @media (max-width: 639.98px) {
    .plate {
      padding: 24px 16px;
    }

    figcaption {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 12px var(--px);
    }

    .watch {
      padding-left: calc(7ch + 12px);
    }
  }
</style>
