---
import type { ImageMetadata } from "astro"
import { Picture } from "astro:assets"
import { langFromPath, ui } from "../../i18n/ui"

export interface Props {
  /** Path inside src/assets, e.g. "cases/2024/internship-at-tech-solutions/nextjs.jpg". */
  src: string
  caption: string
  /**
   * light: dark monochrome diagram on white, inverted in the dark theme.
   * dark: light monochrome diagram on black, inverted in the light theme.
   * color: photos and colored diagrams, never touched.
   */
  tone?: "light" | "dark" | "color"
  /** "bleed" spans the frame edge to edge (wide photos only). */
  mode?: "plate" | "bleed"
  /** Link to where the image comes from; the caption shows only its domain. */
  source?: string
  /** Tighter horizontal padding, for figures inside a Detail block. */
  inset?: boolean
}

const { src, caption, tone = "color", mode = "plate", source, inset = false } = Astro.props
const t = ui[langFromPath(Astro.url.pathname)]
const bleed = mode === "bleed"

// Images live in src/assets so Astro can resize them and convert them to WebP at build time.
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpg,jpeg,png,webp}",
  { eager: true }
)
const image = images[`/src/assets/${src}`]?.default
if (!image) throw new Error(`Figure: no image at src/assets/${src}`)

// Shown at natural size, capped at 760px wide and 640px tall. Setting the width up
// front (with height: auto) reserves the space before the lazy image loads.
const MAX_WIDTH = 760
const MAX_HEIGHT = 640
const displayWidth = Math.round(
  Math.min(image.width, MAX_WIDTH, (MAX_HEIGHT * image.width) / image.height)
)
const sourceHost = source && new URL(source).hostname.replace(/^www\./, "")

// Sizes to generate: phone width, the displayed width and its 2x for sharp screens,
// never larger than the original. Bleed photos span the 1120px frame.
const candidates = bleed ? [640, 1118, 2236] : [400, displayWidth, displayWidth * 2]
const widths = [...new Set(candidates.map((w) => Math.min(w, image.width)))].sort((a, b) => a - b)
const sizes = bleed ? "(min-width: 1120px) 1118px, 100vw" : `min(${displayWidth}px, 100vw)`
---

<figure class:list={["figure", { inset }]}>
  {
    bleed ? (
      <Picture
        src={image}
        alt={caption}
        widths={widths}
        sizes={sizes}
        formats={["webp"]}
        loading="lazy"
        class="bleed"
      />
    ) : (
      <div class="plate">
        <a
          href={image.src}
          target="_blank"
          rel="noreferrer"
          class="zoom"
          aria-label={`${t.fullSizeAria}: ${caption}`}
        >
          <Picture
            src={image}
            alt={caption}
            widths={widths}
            sizes={sizes}
            formats={["webp"]}
            loading="lazy"
            class="image"
            data-tone={tone}
            style={`width: ${displayWidth}px`}
          />
        </a>
      </div>
    )
  }
  <figcaption>
    <span class="label">
      <span class="number">{t.fig} <span class="count"></span></span>
      <span>{caption}</span>
    </span>
    {
      source && (
        <a href={source} target="_blank" rel="noreferrer" class="source">
          {t.source}: {sourceHost} ↗
        </a>
      )
    }
    {
      !bleed && (
        <a href={image.src} target="_blank" rel="noreferrer" class="full">
          {t.fullSize}
        </a>
      )
    }
  </figcaption>
</figure>

<style>
  /* Figures are numbered in reading order across the whole page (see internal/Article). */
  .figure {
    margin: 0;
    border-top: 1px solid var(--line);
    counter-increment: figure;
  }

  .count::before {
    content: counter(figure, decimal-leading-zero);
  }

  .plate {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: clamp(28px, 5vw, 64px) var(--px);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center center;
  }

  .inset .plate {
    padding: clamp(24px, 4vw, 48px) clamp(18px, 3vw, 28px);
  }

  .image {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
    transition: filter 200ms ease;
  }

  /* Monochrome diagrams follow the theme instead of glowing as a white box
     in dark mode; hue-rotate brings colored accents back to their own hue. */
  :global([data-theme="dark"]) .image[data-tone="light"],
  :global([data-theme="light"]) .image[data-tone="dark"] {
    filter: invert(1) hue-rotate(180deg);
  }

  /* <picture> shouldn't add a box of its own; the <img> inside is what gets sized. */
  .figure :global(picture) {
    display: contents;
  }

  /* The image links to the original file, to read small diagram text. */
  .zoom {
    display: flex;
    max-width: 100%;
    cursor: zoom-in;
  }

  /* "Full size" in the caption is only needed on phones (see below). */
  .full {
    display: none;
    opacity: var(--dim);
  }

  .bleed {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    padding: 14px var(--px);
    border-top: 1px solid var(--line);
    font-size: 12px;
    line-height: 1.5;
  }

  .inset figcaption {
    padding: 14px clamp(18px, 3vw, 28px);
  }

  .label {
    display: flex;
    gap: 12px;
    min-width: 0;
  }

  .number {
    flex-shrink: 0;
    opacity: var(--dim);
  }

  .source {
    opacity: var(--dim);
    overflow-wrap: anywhere;
    transition: opacity 150ms ease;
  }

  .source:hover,
  .source:focus-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .image {
      transition: none;
    }
  }

  /* Phones: tighter plate, caption stacked; the source and "Full size" line up
     with the description (7ch = "Fig. 01" in the mono font, + 12px gap). */
  @media (max-width: 639.98px) {
    .plate,
    .inset .plate {
      padding: 24px 16px;
    }

    figcaption,
    .inset figcaption {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 12px var(--px);
    }

    .source,
    .full {
      padding-left: calc(7ch + 12px);
    }

    .full {
      display: inline;
    }
  }
</style>
