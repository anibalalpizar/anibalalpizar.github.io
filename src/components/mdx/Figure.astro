---
import { langFromPath, ui } from "../../i18n/ui"

export interface Props {
  src: string
  width: number
  height: number
  caption: string
  /**
   * light: dark monochrome diagram on white, inverted in the dark theme.
   * dark: light monochrome diagram on black, inverted in the light theme.
   * color: photos and colored diagrams, never touched.
   */
  tone?: "light" | "dark" | "color"
  /** "bleed" spans the frame edge to edge (wide photos only). */
  mode?: "plate" | "bleed"
  /** Link to where the image comes from; the caption shows only its domain. */
  source?: string
  /** Tighter horizontal padding, for figures inside a Detail block. */
  inset?: boolean
}

const { src, width, height, caption, tone = "color", mode = "plate", source, inset = false } =
  Astro.props
const t = ui[langFromPath(Astro.url.pathname)]
const bleed = mode === "bleed"

// Natural size, capped at 760px wide and 640px tall. Setting the width up front
// (with height: auto) reserves the space before the lazy image loads.
const MAX_WIDTH = 760
const MAX_HEIGHT = 640
const displayWidth = Math.round(Math.min(width, MAX_WIDTH, (MAX_HEIGHT * width) / height))
const sourceHost = source && new URL(source).hostname.replace(/^www\./, "")
---

<figure class:list={["figure", { inset }]}>
  {
    bleed ? (
      <img
        src={src}
        alt={caption}
        width={width}
        height={height}
        loading="lazy"
        class="bleed"
      />
    ) : (
      <div class="plate">
        <img
          src={src}
          alt={caption}
          width={width}
          height={height}
          loading="lazy"
          class="image"
          data-tone={tone}
          style={`width: ${displayWidth}px`}
        />
      </div>
    )
  }
  <figcaption>
    <span class="label">
      <span class="number">{t.fig} <span class="count"></span></span>
      <span>{caption}</span>
    </span>
    {
      source && (
        <a href={source} target="_blank" rel="noreferrer" class="source">
          {t.source}: {sourceHost} ↗
        </a>
      )
    }
  </figcaption>
</figure>

<style>
  /* Figures are numbered in reading order across the whole page (see CasePage). */
  .figure {
    margin: 0;
    border-top: 1px solid var(--line);
    counter-increment: figure;
  }

  .count::before {
    content: counter(figure, decimal-leading-zero);
  }

  .plate {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: clamp(28px, 5vw, 64px) var(--px);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center center;
  }

  .inset .plate {
    padding: clamp(24px, 4vw, 48px) clamp(18px, 3vw, 28px);
  }

  .image {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
    transition: filter 200ms ease;
  }

  /* Monochrome diagrams follow the theme instead of glowing as a white box
     in dark mode; hue-rotate brings colored accents back to their own hue. */
  :global([data-theme="dark"]) .image[data-tone="light"],
  :global([data-theme="light"]) .image[data-tone="dark"] {
    filter: invert(1) hue-rotate(180deg);
  }

  .bleed {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    padding: 14px var(--px);
    border-top: 1px solid var(--line);
    font-size: 12px;
    line-height: 1.5;
  }

  .inset figcaption {
    padding: 14px clamp(18px, 3vw, 28px);
  }

  .label {
    display: flex;
    gap: 12px;
    min-width: 0;
  }

  .number {
    flex-shrink: 0;
    opacity: var(--dim);
  }

  .source {
    opacity: var(--dim);
    overflow-wrap: anywhere;
    transition: opacity 150ms ease;
  }

  .source:hover {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .image {
      transition: none;
    }
  }
</style>
