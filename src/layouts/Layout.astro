---
// Geist Mono served from this site instead of Google Fonts: no extra connection
// to another server before text can render. Only the Latin file is preloaded;
// the browser fetches the other subsets only if a page needs them.
import "@fontsource-variable/geist-mono"
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url"
import CommandMenu from "../components/CommandMenu.astro"
import Header from "../components/Header.astro"
import { SITE_URL, type Page } from "../data/site"
import { localePath, ui, type Lang } from "../i18n/ui"

interface Props {
  lang: Lang
  title: string
  /** Page path without the language prefix, e.g. "/" or "/projects". */
  path: string
  page: Page
  /** For search results and link previews; defaults to the site description. */
  description?: string
  /** schema.org JSON-LD for the page (see src/utils/structuredData.ts). */
  structuredData?: object
  /** 1200×630 social preview; defaults to the designer's image for the language. */
  ogImage?: { path: string; alt: string }
  /** Case studies and posts are articles for link previews. */
  article?: { publishedTime: string }
}

const {
  lang,
  title,
  path,
  page,
  description = ui[lang].description,
  structuredData,
  ogImage = { path: `/og/og-default-${lang}.png`, alt: ui[lang].docTitle },
  article,
} = Astro.props
// "<" escaped so text inside the data can never close the <script> tag early.
const jsonLd = structuredData && JSON.stringify(structuredData).replace(/</g, "\\u003c")
// Absolute URL; localePath already adds the trailing slash the sitemap uses too.
const urlFor = (target: Lang) => new URL(localePath(target, path), SITE_URL).href
const spanishHref = localePath("es", path)
// Social previews need an absolute URL.
const shareImage = new URL(ogImage.path, SITE_URL).href
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      page === "not-found" ? (
        <meta name="robots" content="noindex" />
      ) : (
        <Fragment>
          <link rel="canonical" href={urlFor(lang)} />
          <link rel="alternate" hreflang="en" href={urlFor("en")} />
          <link rel="alternate" hreflang="es" href={urlFor("es")} />
          <link rel="alternate" hreflang="x-default" href={urlFor("en")} />
        </Fragment>
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:url" content={urlFor(lang)} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    <meta property="og:site_name" content="Aníbal Alpízar" />
    <meta property="og:locale" content={lang === "es" ? "es_CR" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_CR"} />
    <!-- Large card: the preview images are 1200×630. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={ogImage.alt} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${ui[lang].navBlog} — Aníbal Alpízar`}
      href={new URL(lang === "es" ? "/es/rss.xml" : "/rss.xml", SITE_URL).href}
    />
    <link rel="icon" type="image/jpg" href="/logo.jpg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ lang, spanishHref, page }}>
      try {
        // Dark is the default; only an explicit choice switches to light.
        // Key must match STORAGE_KEY in src/scripts/theme.ts.
        if (localStorage.getItem("site-theme") === "light") {
          document.documentElement.dataset.theme = "light"
        }
        // English pages send Spanish speakers to /es/ unless they chose English.
        // Key must match LANG_KEY in src/scripts/lang.ts.
        var chosen = localStorage.getItem("lang")
        var prefersSpanish = chosen === "es" || (!chosen && navigator.language.toLowerCase().startsWith("es"))
        if (page === "not-found") {
          // GitHub Pages serves the English 404 for every missing path, /es/ ones
          // included; hand the broken path to the Spanish 404 so it can show it.
          if (lang === "en" && (prefersSpanish || location.pathname.startsWith("/es/"))) {
            location.replace(spanishHref + "?path=" + encodeURIComponent(location.pathname))
          }
        } else if (lang === "en" && prefersSpanish) {
          location.replace(spanishHref + location.search + location.hash)
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class="site">
      <div class="frame">
        <Header lang={lang} page={page} path={path} />
        <slot />
      </div>
    </div>
    <CommandMenu lang={lang} path={path} />
  </body>
</html>

<script>
  import { restoreScroll } from "../scripts/lang"
  import { scrollToId } from "../scripts/scroll"

  restoreScroll()

  // In-page links (`/#section`) scroll smoothly below the sticky header.
  // On pages without that section they fall through to normal navigation.
  document.addEventListener("click", (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return
    const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-scroll-to]")
    if (link && scrollToId(link.dataset.scrollTo!)) event.preventDefault()
  })
</script>

<style is:global>
  :root {
    --bg: #000000;
    --fg: #ededed;
    --muted: #a1a1a1;
    --line: #232323;
    --line-inv: #cccccc;
    --cross: #5e5e5e;
    --guide: #333333;
    --hover: #141414;
    --active: #1c1c1c;
    --surface: #0a0a0a;
    --glass: rgba(0, 0, 0, 0.72);
    --overlay: rgba(0, 0, 0, 0.72);
    --shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.8);
    --font: "Geist Mono Variable", "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --px: clamp(20px, 4vw, 32px);
    --dim: 0.62;
    color-scheme: dark;
  }

  :root[data-theme="light"] {
    --bg: #ffffff;
    --fg: #0a0a0a;
    --muted: #666666;
    --line: #e6e6e6;
    --line-inv: #2a2a2a;
    --cross: #999999;
    --guide: #d6d6d6;
    --hover: #f4f4f4;
    --active: #f2f2f2;
    --surface: #ffffff;
    --glass: rgba(255, 255, 255, 0.82);
    --overlay: rgba(10, 10, 10, 0.18);
    --shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.2);
    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font);
    font-size: 15px;
    line-height: 1.5;
  }

  h1,
  h2,
  h3,
  h4,
  p,
  figure {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font-family: inherit;
    color: inherit;
  }

  ::selection {
    background: var(--fg);
    color: var(--bg);
  }

  /* Keyboard focus: a ring in the current text colour, so it also shows on
     inverted rows and in the light Contact block. Mouse clicks don't show it. */
  :focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  a,
  button {
    -webkit-tap-highlight-color: transparent;
  }

  /* Anchor targets land below the 56px sticky header. */
  [id] {
    scroll-margin-top: 56px;
  }

  /* overflow-x: clip (not hidden) keeps the sticky header working
     while hiding the "+" marks that poke past the frame. */
  .site {
    min-height: 100vh;
    overflow-x: clip;
    background: var(--bg);
    color: var(--fg);
  }

  .frame {
    max-width: 1120px;
    min-height: 100vh;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }

  /* Internal pages (case studies, /projects) fill the frame so the footer sits at the bottom. */
  .page {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
