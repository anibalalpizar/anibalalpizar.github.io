---
// Geist Mono served from this site instead of Google Fonts: no extra connection
// to another server before text can render. Only the Latin file is preloaded;
// the browser fetches the other subsets only if a page needs them.
import "@fontsource-variable/geist-mono"
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url"
import CommandMenu from "../components/CommandMenu.astro"
import Header from "../components/Header.astro"
import Terminal from "../components/Terminal.astro"
import { SITE_URL, type Page } from "../data/site"
import { localePath, ui, type Lang } from "../i18n/ui"

interface Props {
  lang: Lang
  title: string
  /** Page path without the language prefix, e.g. "/" or "/projects". */
  path: string
  page: Page
  /** For search results and link previews; defaults to the site description. */
  description?: string
  /** schema.org JSON-LD for the page (see src/utils/structuredData.ts). */
  structuredData?: object
  /** 1200×630 social preview; defaults to the designer's image for the language. */
  ogImage?: { path: string; alt: string }
  /** Case studies and posts are articles for link previews. */
  article?: { publishedTime: string }
}

const {
  lang,
  title,
  path,
  page,
  description = ui[lang].description,
  structuredData,
  ogImage = { path: `/og/og-default-${lang}.png`, alt: ui[lang].docTitle },
  article,
} = Astro.props
// "<" escaped so text inside the data can never close the <script> tag early.
const jsonLd = structuredData && JSON.stringify(structuredData).replace(/</g, "\\u003c")
// Absolute URL; localePath already adds the trailing slash the sitemap uses too.
const urlFor = (target: Lang) => new URL(localePath(target, path), SITE_URL).href
const spanishHref = localePath("es", path)
// Social previews need an absolute URL.
const shareImage = new URL(ogImage.path, SITE_URL).href
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Page transitions (styles at the end of this file). The opt-in is written
         here rather than in the stylesheet: Chrome checks it as soon as the page
         starts, and a stylesheet still loading at that moment cancels the
         transition. Off for people who ask their system for less motion. -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    {
      page === "not-found" ? (
        <meta name="robots" content="noindex" />
      ) : (
        <Fragment>
          <link rel="canonical" href={urlFor(lang)} />
          <link rel="alternate" hreflang="en" href={urlFor("en")} />
          <link rel="alternate" hreflang="es" href={urlFor("es")} />
          <link rel="alternate" hreflang="x-default" href={urlFor("en")} />
        </Fragment>
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:url" content={urlFor(lang)} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    <meta property="og:site_name" content="Aníbal Alpízar" />
    <meta property="og:locale" content={lang === "es" ? "es_CR" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_CR"} />
    <!-- Large card: the preview images are 1200×630. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={ogImage.alt} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${ui[lang].navBlog} — Aníbal Alpízar`}
      href={new URL(lang === "es" ? "/es/rss.xml" : "/rss.xml", SITE_URL).href}
    />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <!-- Home-screen icon on iPhone and iPad; iOS rounds the corners itself. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Colour of the phone browser's address bar; switched with the theme. -->
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ lang, spanishHref, page }}>
      try {
        // Dark is the default; only an explicit choice switches to light.
        // Key must match STORAGE_KEY in src/scripts/theme.ts.
        if (localStorage.getItem("site-theme") === "light") {
          document.documentElement.dataset.theme = "light"
          document.querySelector('meta[name="theme-color"]').content = "#ffffff"
        }
        // English pages send Spanish speakers to /es/ unless they chose English.
        // Key must match LANG_KEY in src/scripts/lang.ts.
        var chosen = localStorage.getItem("lang")
        var prefersSpanish = chosen === "es" || (!chosen && navigator.language.toLowerCase().startsWith("es"))
        if (page === "not-found") {
          // GitHub Pages serves the English 404 for every missing path, /es/ ones
          // included; hand the broken path to the Spanish 404 so it can show it.
          if (lang === "en" && (prefersSpanish || location.pathname.startsWith("/es/"))) {
            location.replace(spanishHref + "?path=" + encodeURIComponent(location.pathname))
          }
        } else if (lang === "en" && prefersSpanish) {
          location.replace(spanishHref + location.search + location.hash)
        }
        // Switching language returns to the same scroll position (restoreScroll in
        // src/scripts/lang.ts), which can happen after the first frame: no page
        // transition there, or the new page could show at the top and then jump.
        // Read now: restoreScroll clears the key before "pagereveal" may fire.
        // Key must match SCROLL_KEY in src/scripts/lang.ts.
        var switchingLanguage = sessionStorage.getItem("restore-scroll") != null
        addEventListener("pagereveal", function (event) {
          if (switchingLanguage && event.viewTransition) event.viewTransition.skipTransition()
        })
      } catch {}
    </script>
    <script is:inline>
      // Page transitions: elements with data-transition (src/utils/transitions.ts)
      // get their name only while a page is left or shown, and only if they're on
      // screen and go with the page on the other side: the link that was followed,
      // the row of the page we came back from, or this page's own hero.
      ;(function () {
        function path(url) {
          try {
            return new URL(url, location.href).pathname
          } catch (e) {
            return ""
          }
        }
        function onScreen(el) {
          var box = el.getBoundingClientRect()
          return box.bottom > 0 && box.top < innerHeight
        }
        function nameFor(other) {
          document.querySelectorAll("[data-transition]").forEach(function (el) {
            var target = el.getAttribute("data-transition-for")
            el.style.viewTransitionName =
              (target == null || path(target) === other) && onScreen(el) ? el.getAttribute("data-transition") : ""
          })
        }
        // A page restored by the back button starts again with no names.
        addEventListener("pageshow", function (event) {
          if (!event.persisted) return
          document.querySelectorAll("[data-transition]").forEach(function (el) {
            el.style.viewTransitionName = ""
          })
        })
        // Browsers without the Navigation API don't say where a link leads; the click does.
        var followed = ""
        addEventListener("click", function (event) {
          var link = event.target.closest && event.target.closest("a[href]")
          if (link) followed = link.href
        }, true)
        addEventListener("pageswap", function (event) {
          if (event.viewTransition) nameFor(path(event.activation ? event.activation.entry.url : followed))
        })
        addEventListener("pagereveal", function (event) {
          if (!event.viewTransition) return
          // The Navigation API (not in TypeScript's types yet) gives the page we came from.
          var nav = /** @type {any} */ (window).navigation
          var activation = nav && nav.activation
          // A link to a section of this page (/#experience): the browser would
          // scroll there only after the page shows, so it would appear at the top
          // and jump. Go there first. Back/forward keeps its own scroll position.
          if (location.hash && activation && activation.navigationType !== "traverse") {
            var section = document.getElementById(decodeURIComponent(location.hash.slice(1)))
            if (section) section.scrollIntoView()
          }
          nameFor(path(activation && activation.from ? activation.from.url : document.referrer))
        })
      })()
    </script>
  </head>
  <body>
    <div class="site">
      <div class="frame">
        <Header lang={lang} page={page} path={path} />
        <slot />
      </div>
    </div>
    <CommandMenu lang={lang} path={path} />
    <Terminal lang={lang} path={path} />
  </body>
</html>

<script>
  import { restoreScroll } from "../scripts/lang"
  import { scrollToId } from "../scripts/scroll"

  restoreScroll()

  // In-page links (`/#section`) scroll smoothly below the sticky header.
  // On pages without that section they fall through to normal navigation.
  document.addEventListener("click", (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return
    const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-scroll-to]")
    if (link && scrollToId(link.dataset.scrollTo!)) event.preventDefault()
  })
</script>

<style is:global>
  :root {
    --bg: #000000;
    --fg: #ededed;
    --muted: #a1a1a1;
    --line: #232323;
    --line-inv: #cccccc;
    --cross: #5e5e5e;
    --guide: #333333;
    --hover: #141414;
    --active: #1c1c1c;
    --surface: #0a0a0a;
    --glass: rgba(0, 0, 0, 0.72);
    --overlay: rgba(0, 0, 0, 0.72);
    --shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.8);
    --font: "Geist Mono Variable", "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --px: clamp(20px, 4vw, 32px);
    --dim: 0.62;
    color-scheme: dark;
  }

  :root[data-theme="light"] {
    --bg: #ffffff;
    --fg: #0a0a0a;
    --muted: #666666;
    --line: #e6e6e6;
    --line-inv: #2a2a2a;
    --cross: #999999;
    --guide: #d6d6d6;
    --hover: #f4f4f4;
    --active: #f2f2f2;
    --surface: #ffffff;
    --glass: rgba(255, 255, 255, 0.82);
    --overlay: rgba(10, 10, 10, 0.18);
    --shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.2);
    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font);
    font-size: 15px;
    line-height: 1.5;
  }

  h1,
  h2,
  h3,
  h4,
  p,
  figure {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font-family: inherit;
    color: inherit;
  }

  ::selection {
    background: var(--fg);
    color: var(--bg);
  }

  /* Keyboard focus: a ring in the current text colour, so it also shows on
     inverted rows and in the light Contact block. Mouse clicks don't show it. */
  :focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  a,
  button {
    -webkit-tap-highlight-color: transparent;
  }

  /* Read by screen readers, not shown: labels and data tables behind charts. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Page transitions, turned on in <head>. Browsers with cross-document view
     transitions (Chrome, Edge, Safari 18.2+) animate from one page to the next;
     the others just navigate.

     What leaves fades out fast and what arrives fades in right after, so the
     two pages barely overlap. */
  ::view-transition-old(*) {
    animation: 120ms cubic-bezier(0.4, 0, 1, 1) both fade-out;
  }

  ::view-transition-new(*) {
    animation: 240ms cubic-bezier(0, 0, 0.2, 1) 90ms both fade-in;
  }

  /* The page itself, and named elements with no counterpart on the other page
     (a case study's hero when the logo leads home, say), leave going up and
     arrive from below. */
  ::view-transition-old(root),
  ::view-transition-old(*):only-child {
    animation-name: page-out;
  }

  ::view-transition-new(root),
  ::view-transition-new(*):only-child {
    animation-name: page-in;
  }

  /* Elements named on both pages (a row and the page it opens, "Projects" and
     its page; see src/utils/transitions.ts) move and resize from one place to
     the other. */
  ::view-transition-group(*) {
    animation-duration: 420ms;
    animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  /* The header (named in Header.astro) doesn't move or fade: the new one shows
     straight away, with the current page's link already highlighted. */
  ::view-transition-old(site-header) {
    display: none;
  }

  ::view-transition-new(site-header) {
    animation: none;
  }

  /* Switching theme (src/scripts/theme.ts): the new page spreads in a circle
     over the old one, which stays still underneath. The header is part of the
     page here, so it changes with the rest. */
  html.theme-transition::view-transition-old(root),
  html.theme-transition::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  html.theme-transition .header {
    view-transition-name: none;
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes page-out {
    to {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @keyframes page-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Anchor targets land below the 56px sticky header. */
  [id] {
    scroll-margin-top: 56px;
  }

  /* overflow-x: clip (not hidden) keeps the sticky header working
     while hiding the "+" marks that poke past the frame. */
  .site {
    min-height: 100vh;
    overflow-x: clip;
    background: var(--bg);
    color: var(--fg);
  }

  .frame {
    max-width: 1120px;
    min-height: 100vh;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }

  /* Internal pages (case studies, /projects) fill the frame so the footer sits at the bottom. */
  .page {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
