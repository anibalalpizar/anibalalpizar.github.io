---
import { getCollection } from "astro:content"
import CasePage from "../../../components/pages/CasePage.astro"

export async function getStaticPaths() {
  const entries = await getCollection("cases", ({ id }) => id.startsWith("es/"))
  return entries.map((entry) => {
    const [, year, slug] = entry.data.path.split("/")
    return { params: { year, slug }, props: { entry } }
  })
}

const { entry } = Astro.props
---

<CasePage lang="es" entry={entry} />
